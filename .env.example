# Copy to .env.staging or .env.production and fill in. Never commit a real one.

# Which environment this instance reports as. staging | production
APP_ENV=staging

# Anthropic credentials and model. The model is deliberately identical in every
# environment so CI validates the same configuration production runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Company Brain mount point inside the container.
BRAIN_DIR=/app/company_brain

# Bearer token for the admin endpoints (Brain activation / rollback).
ADMIN_API_TOKEN=

LOG_LEVEL=INFO

# Loop and timeout guards for a single applicant run.
MAX_STEPS_PER_APPLICANT=12
REQUEST_TIMEOUT_SECONDS=120

# Container-internal port. The host binding is set per environment in the
# compose file, not here.
PORT=8000
